@model IEnumerable<CineBookerEnterprise.Models.ViewModels.MovieListItemViewModel>

@{
    ViewData["Title"] = "Manage Movies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Manage Movies</h1>
    <a asp-action="Create" class="btn btn-primary">Add New Movie</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Poster</th>
            <th>Title</th>
            <th>Genre</th>
            <th>Duration</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><img src="@item.PosterUrl" alt="@item.Title" style="height: 50px;" /></td>
                <td>@item.Title</td>
                <td>@item.Genre</td>
                <td>@item.DurationMinutes mins</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
