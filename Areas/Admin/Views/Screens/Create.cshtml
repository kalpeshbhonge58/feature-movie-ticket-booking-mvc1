@model CineBookerEnterprise.Models.ViewModels.ScreenFormViewModel

@{
    ViewData["Title"] = "Add Screen";
}

<h1>Add New Screen</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <input type="hidden" asp-for="TheaterId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rows" class="form-label"></label>
                <input asp-for="Rows" class="form-control" />
                <span asp-validation-for="Rows" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SeatsPerRow" class="form-label"></label>
                <input asp-for="SeatsPerRow" class="form-control" />
                <span asp-validation-for="SeatsPerRow" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>
