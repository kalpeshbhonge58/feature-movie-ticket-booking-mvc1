@model CineBookerEnterprise.Models.ViewModels.MovieDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <img src="@Model.PosterUrl" class="img-fluid rounded shadow" alt="@Model.Title">
        </div>
        <div class="col-md-8">
            <h1 class="display-4">@Model.Title</h1>
            <p class="lead"><strong>Genre:</strong> @Model.Genre | <strong>Duration:</strong> @Model.DurationMinutes mins</p>
            <hr>
            <h3>Description</h3>
            <p>@Model.Description</p>

            <div class="mt-5">
                <h3>Available Shows</h3>
                @if (Model.AvailableShows != null && Model.AvailableShows.Any())
                {
                    <div class="list-group">
                        @foreach (var show in Model.AvailableShows)
                        {
                            <a asp-controller="Booking" asp-action="SelectSeats" asp-route-showId="@show.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@show.StartTime.ToString("f")</strong>
                                    <br>
                                    <small class="text-muted">@show.TheaterName - @show.ScreenName</small>
                                </div>
                                <span class="badge bg-success rounded-pill">@show.Price.ToString("C")</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No upcoming shows available for this movie.</p>
                }
            </div>
        </div>
    </div>
</div>
