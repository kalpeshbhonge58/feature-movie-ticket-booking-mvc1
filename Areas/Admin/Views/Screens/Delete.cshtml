@model CineBookerEnterprise.Models.ViewModels.ScreenViewModel

@{
    ViewData["Title"] = "Delete Screen";
}

<h1>Delete Screen</h1>
<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Capacity</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="btn btn-secondary">Cancel</a>
    </form>
</div>
