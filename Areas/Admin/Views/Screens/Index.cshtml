@model IEnumerable<CineBookerEnterprise.Models.ViewModels.ScreenViewModel>

@{
    ViewData["Title"] = "Manage Screens";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Screens for @ViewBag.TheaterName</h1>
    <div>
        <a asp-action="Create" asp-route-theaterId="@ViewBag.TheaterId" class="btn btn-primary">Add New Screen</a>
        <a asp-controller="Theaters" asp-action="Index" class="btn btn-secondary">Back to Theaters</a>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Capacity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Capacity</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
