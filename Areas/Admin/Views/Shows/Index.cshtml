@model IEnumerable<CineBookerEnterprise.Models.ViewModels.ShowViewModel>

@{
    ViewData["Title"] = "Manage Shows";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Manage Shows</h1>
    <a asp-action="Create" class="btn btn-primary">Add New Show</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Movie</th>
            <th>Theater - Screen</th>
            <th>Start Time</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MovieTitle</td>
                <td>@item.TheaterName - @item.ScreenName</td>
                <td>@item.StartTime.ToString("g")</td>
                <td>@item.Price.ToString("C")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
