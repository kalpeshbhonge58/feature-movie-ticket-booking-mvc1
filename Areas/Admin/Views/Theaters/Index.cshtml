@model IEnumerable<CineBookerEnterprise.Models.ViewModels.TheaterViewModel>

@{
    ViewData["Title"] = "Manage Theaters";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Manage Theaters</h1>
    <a asp-action="Create" class="btn btn-primary">Add New Theater</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Location</td>
                <td>
                    <a asp-controller="Screens" asp-action="Index" asp-route-theaterId="@item.Id" class="btn btn-sm btn-info">Screens</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
