@model CineBookerEnterprise.Models.ViewModels.SeatSelectionViewModel

@{
    ViewData["Title"] = "Select Seats";
    var seatsByRow = Model.Seats.GroupBy(s => s.Row).OrderBy(g => g.Key);
}

<div class="container mt-4">
    <form id="antiForgeryForm">
        @Html.AntiForgeryToken()
    </form>
    <div class="row">
        <div class="col-md-8">
            <h2 class="mb-4">Select Seats for @Model.MovieTitle</h2>
            <p class="text-muted">@Model.TheaterName - @Model.ScreenName | @Model.StartTime.ToString("f")</p>

            <div class="screen-container mb-5 text-center">
                <div class="screen-box p-2 bg-secondary text-white mb-4">SCREEN</div>

                <div id="seat-grid" class="d-inline-block">
                    @foreach (var row in seatsByRow)
                    {
                        <div class="seat-row d-flex justify-content-center mb-2">
                            <div class="row-label me-3 align-self-center">@row.Key</div>
                            @foreach (var seat in row.OrderBy(s => s.Number))
                            {
                                <div class="seat m-1"
                                     data-seat-id="@seat.Id"
                                     data-seat-name="@seat.Row@seat.Number"
                                     title="@seat.Row@seat.Number">
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="legend d-flex justify-content-center mt-4">
                <div class="me-4"><div class="seat legend-seat available d-inline-block me-1"></div> Available</div>
                <div class="me-4"><div class="seat legend-seat selected d-inline-block me-1"></div> Selected</div>
                <div><div class="seat legend-seat booked d-inline-block me-1"></div> Booked</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-4">Booking Summary</h4>
                    <p><strong>Movie:</strong> @Model.MovieTitle</p>
                    <p><strong>Price per seat:</strong> @Model.Price.ToString("C")</p>
                    <hr>
                    <p><strong>Selected Seats:</strong> <span id="selected-seats-list">None</span></p>
                    <p><strong>Total Price:</strong> <span id="total-price">$0.00</span></p>
                    <button id="btn-proceed" class="btn btn-primary w-100 mt-3" disabled>Proceed to Payment</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .seat {
            width: 30px;
            height: 30px;
            background-color: #28a745;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .seat.selected {
            background-color: #007bff;
        }
        .seat.booked {
            background-color: #dc3545;
            cursor: not-allowed;
        }
        .screen-box {
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
            border-bottom: 5px solid #6c757d;
            box-shadow: 0 10px 10px -10px rgba(0,0,0,0.5);
        }
        .legend-seat {
            width: 20px;
            height: 20px;
            cursor: default;
        }
        .available { background-color: #28a745; }
        .selected { background-color: #007bff; }
        .booked { background-color: #dc3545; }
    </style>

    <script>
        $(document).ready(function () {
            const showId = @Model.ShowId;
            const pricePerSeat = @Model.Price;
            let selectedSeats = [];

            // Fetch booked seats
            $.get(`/Booking/GetBookedSeats?showId=${showId}`, function (bookedIds) {
                bookedIds.forEach(id => {
                    $(`.seat[data-seat-id="${id}"]`).addClass('booked').off('click');
                });
            });

            // Handle seat click
            $('.seat:not(.booked)').click(function () {
                const seatId = $(this).data('seat-id');
                const seatName = $(this).data('seat-name');

                if ($(this).hasClass('selected')) {
                    $(this).removeClass('selected');
                    selectedSeats = selectedSeats.filter(s => s.id !== seatId);
                } else {
                    $(this).addClass('selected');
                    selectedSeats.push({ id: seatId, name: seatName });
                }

                updateSummary();
            });

            function updateSummary() {
                if (selectedSeats.length > 0) {
                    $('#selected-seats-list').text(selectedSeats.map(s => s.name).join(', '));
                    $('#total-price').text('$' + (selectedSeats.length * pricePerSeat).toFixed(2));
                    $('#btn-proceed').prop('disabled', false);
                } else {
                    $('#selected-seats-list').text('None');
                    $('#total-price').text('$0.00');
                    $('#btn-proceed').prop('disabled', true);
                }
            }

            $('#btn-proceed').click(function () {
                const seatIds = selectedSeats.map(s => s.id);
                const token = $('input[name="__RequestVerificationToken"]', $('#antiForgeryForm')).val();

                $.ajax({
                    url: '/Booking/CreateBooking',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        "RequestVerificationToken": token
                    },
                    data: JSON.stringify({ showId: showId, seatIds: seatIds }),
                    success: function (response) {
                        if (response.success) {
                            window.location.href = `/Booking/Payment?bookingId=${response.bookingId}`;
                        }
                    },
                    error: function (xhr) {
                        const err = JSON.parse(xhr.responseText);
                        alert(err.message || "An error occurred during booking.");
                    }
                });
            });
        });
    </script>
}
